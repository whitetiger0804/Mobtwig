# 실제 개발 서버의 API 기준 주소입니다. 홈 SDUI 요청에도 사용합니다.
# 아래 주소는 Android 에뮬레이터에서 개발 PC의 서버에 접근하는 예시입니다.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# 간이 서버입니다. USB 기기·에뮬레이터는 adb reverse tcp:8090 tcp:8090으로 연결합니다.
EXPO_PUBLIC_MOCK_API_URL=http://127.0.0.1:8090

# 일반 실행은 false이며 npm run start:test가 해당 프로세스에서만 true로 설정합니다.
EXPO_PUBLIC_ENABLE_SERVER_SELECTION=false
