# 실제 API입니다.
EXPO_PUBLIC_API_URL=https://mobtwig.xn--3h3b098b.kro.kr

# 간이 API입니다. PC 웹 localhost:8090 / Android 에뮬레이터 10.0.2.2:8090 / 실기기 {개발 PC IP}:8090을 사용합니다.
# 아이폰은 모릅니다. 알아서 잘 하십쇼. 일단 난 잘 됨
EXPO_PUBLIC_MOCK_API_URL=http://127.0.0.1:8090

# 일반 실행은 false이며 npm run start:test가 해당 프로세스에서만 true로 설정합니다.
EXPO_PUBLIC_ENABLE_SERVER_SELECTION=false
