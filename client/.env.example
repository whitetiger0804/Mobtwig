# 실제 API입니다.
EXPO_PUBLIC_API_URL=https://mobtwig.xn--3h3b098b.kro.kr

# 테스트용 API입니다. 로컬 Spring 서버 주소도 지정할 수 있습니다.
EXPO_PUBLIC_MOCK_API_URL=http://127.0.0.1:8080

# Android·iOS의 LAN 테스트에서 Expo PC 주소를 사용합니다. USB 연결은 false로 지정합니다. 웹에는 적용하지 않습니다.
EXPO_PUBLIC_MOCK_USE_EXPO_HOST=true

# 일반 실행은 false이며 npm run start:test가 해당 프로세스에서만 true로 설정합니다.
EXPO_PUBLIC_ENABLE_SERVER_SELECTION=false
