{
  "name": "mobtwig-client",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "58.0.23",
    "expo-dev-client": "~58.0.18",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typedoc": "0.28.20",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "node scripts/start-expo.mjs",
    "start:go": "node scripts/start-expo.mjs --go",
    "start:test": "node scripts/start-expo.mjs --server-selection",
    "mock": "node ../server/mock/index.mjs",
    "android": "node scripts/run-android.mjs",
    "android:go": "node scripts/start-expo.mjs --go --android",
    "ios": "expo run:ios",
    "ios:go": "node scripts/start-expo.mjs --go --ios",
    "web": "node scripts/start-expo.mjs --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/readingProgress.test.mjs tests/memberSignup.test.mjs tests/memberSession.test.mjs tests/homeSchema.test.mjs tests/workDetails.test.mjs tests/readerNavigation.test.mjs tests/chapterText.test.mjs ../server/mock/server.test.mjs",
    "docs": "typedoc"
  },
  "engines": {
    "node": "24.21.0",
    "npm": "12.1.0"
  },
  "packageManager": "npm@12.1.0",
  "private": true
}
