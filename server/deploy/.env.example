# 이 예시를 서버의 별도 설정 경로에 .env로 복사합니다.
# DB_PASSWORD와 DB_ROOT_PASSWORD는 서로 다른 충분히 긴 값으로 설정합니다.
# 비밀번호는 영문 대소문자와 숫자로 작성하고 실제 .env는 Git에 커밋하지 않습니다.
DB_NAME=mobtwig_shared
DB_USERNAME=mobtwig_app
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 서버에서만 열리는 포트입니다. 외부 접속은 별도 Tailscale Serve 설정을 사용합니다.
DB_PORT=3307
API_PORT=8080

# 배포 스크립트가 검증한 ghcr.io/...@sha256:... 주소를 주입합니다.
# Compose를 직접 실행할 때에는 이 값을 별도로 지정해야 합니다.
API_IMAGE=
