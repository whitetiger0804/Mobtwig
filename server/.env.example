# 이 파일을 .env로 복사하고 두 비밀번호에 서로 다른 값을 입력합니다.
# 비밀번호는 따옴표 없이 충분히 긴 영문 대소문자와 숫자로 작성합니다.
# .env는 Git에 커밋하지 않습니다.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=mobtwig_dev
DB_USERNAME=mobtwig_app
DB_PASSWORD=
DB_ROOT_PASSWORD=
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NICKNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# 정적 공개 폴더 밖의 UTF-8 .txt 보관 폴더입니다. 로컬 Java 실행용입니다.
CONTENT_ROOT=./content

# 인증 웹 CORS 허용 origin은 정확한 주소만 쉼표로 지정합니다. 웹/API는 same-site 구성입니다.
AUTH_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# 개발·시연 전용 서버에서만 true로 설정하십시오.
SIGNUP_DEMO_ENABLED=false
