{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mobtwig 테스트 DB 실행",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "--project-name", "mobtwig-test84",
        "--env-file", ".env",
        "-f", "db/compose.yaml",
        "up", "-d", "--wait", "--wait-timeout", "180"
      ],
      "options": {
        "cwd": "${workspaceFolder}/server",
        "env": {
          "DB_HOST": "127.0.0.1",
          "DB_PORT": "3308",
          "DB_NAME": "mobtwig_test"
        }
      },
      "problemMatcher": []
    }
  ]
}
